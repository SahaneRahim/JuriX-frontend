 "anims": {
  "RefonteAccueil": [
   [
    "/* balance : le fléau pivote, les plateaux restent à l'horizontale */\n.bal .bm",
    "bm 1.9s var(--ease) .35s both"
   ],
   [
    ".bal .pl",
    "pn 1.9s var(--ease) .35s both"
   ],
   [
    ".bal .pr",
    "pn 1.9s var(--ease) .35s both"
   ],
   [
    ".eyebrow",
    "rise .6s var(--ease) both"
   ],
   [
    ".wi",
    "word .9s var(--ease) both"
   ],
   [
    "/* ——— le champ unique ——— */\n.cmpw",
    "rise .8s var(--ease) .65s both"
   ],
   [
    ".cmpw::before",
    "fade .8s ease 1.1s both"
   ],
   [
    ".cmpw::after",
    "fade .8s ease 1.25s both"
   ],
   [
    ".caret",
    "caret 1s steps(1) infinite"
   ],
   [
    ".sugs.fa .sq",
    "sqa"
   ],
   [
    ".sugs.fb .sq",
    "sqb"
   ],
   [
    ".pcs.play .cc,.pcs.done .pc:hover .cc",
    "popL .7s cubic-bezier(.3,1.6,.5,1) both"
   ],
   [
    ".pcs.play .st,.pcs.done .pc:hover .st",
    "stL .6s var(--ease) both"
   ],
   [
    ".pcs.play .hlk,.pcs.done .pc:hover .hlk",
    "hlL 1s var(--ease) .15s both"
   ],
   [
    ".dt",
    "rise .7s var(--ease) backwards"
   ],
   [
    ".dt.hop:hover .dti",
    "hop"
   ],
   [
    ".dt.tap:hover .dti",
    "tap"
   ],
   [
    ".dt.tilt:hover .dti",
    "tilt"
   ],
   [
    ".dt.press:hover .dti",
    "press"
   ],
   [
    ".dt.swing:hover .dti",
    "swing"
   ],
   [
    ".dt.sway:hover .dti",
    "sway"
   ],
   [
    ".dt.spin:hover .dti",
    "spin"
   ],
   [
    ".dt.flip:hover .dti",
    "flip"
   ],
   [
    ".dt.beat:hover .dti",
    "beat"
   ],
   [
    ".dt.weigh:hover .dti",
