{
  // Étend le tsconfig GÉNÉRÉ par `svelte-kit sync`, qui porte les alias $lib et
  // $app. Ce fichier n'existait pas : personne n'étendait le fichier généré,
  // donc aucun alias n'était résolu. `svelte-check` remontait 86 erreurs
  // « Cannot find module '$lib/...' » qui noyaient les vraies, et TOUT type
  // traversant une frontière de module devenait `any` implicite — l'outil était
  // aveugle sur la totalité du code applicatif.
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,

    // Le fichier généré déclare `"types": ["node"]`, ce qui EXCLUT les globales
    // de vitest et les matchers de jest-dom : sans cette liste, `src/tests/setup.ts`
    // remonte des erreurs qui ne sont pas des défauts du code.
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],

    // `strict` est ACTIF depuis que `$lib/types.ts` existe.
    //
    // Il restait désactivé tant que le code portait 34 annotations `: any` et
    // aucun type métier : l'activer plus tôt aurait produit un mur d'erreurs sur
    // du code qui fonctionne, avant que les types (law, article, user,
    // searchResult) existent pour y répondre. Ordre suivi : les types d'abord,
    // la résorption des `any` ensuite, `strict` en dernier.
    "strict": true
  }
}
